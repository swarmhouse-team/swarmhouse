# Скопируйте в .env (pnpm i делает это автоматически, если .env ещё нет).
# Секреты в репозиторий не коммитим.

NODE_ENV=development

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=robots
POSTGRES_PASSWORD=robots
POSTGRES_DB=robots
POSTGRES_PORT=5432
DATABASE_URL=postgresql://robots:robots@localhost:5432/robots?schema=public

# Redis (docker-compose.yml). API подключается только при CACHE_DRIVER=redis.
REDIS_PORT=6379

# Backend (apps/api)
API_PORT=3001

# Кэш. CACHE_DRIVER обязателен: memory или redis.
# memory не открывает Redis и не проверяет его в health.
# redis не подменяется memory.
CACHE_DRIVER=memory
CACHE_MEMORY_MAX_ENTRIES=1000

# Только для CACHE_DRIVER=redis. URL в ошибках конфигурации не печатается.
# REDIS_URL=redis://localhost:6379
# CACHE_KEY_PREFIX=robots:

# Frontend (apps/web): куда Next проксирует запросы /api/*
API_INTERNAL_URL=http://localhost:3001
