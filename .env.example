# Скопируйте в .env (pnpm i делает это автоматически, если .env ещё нет).
# Секреты в репозиторий не коммитим.

NODE_ENV=development

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=robots
POSTGRES_PASSWORD=robots
POSTGRES_DB=robots
POSTGRES_PORT=5432
DATABASE_URL=postgresql://robots:robots@localhost:5432/robots?schema=public

# Отдельный PostgreSQL для интеграционных тестов (docker compose --profile test).
# Не указывайте сюда основную базу: guard сравнивает host, порт и имя БД.
POSTGRES_TEST_USER=robots_test
POSTGRES_TEST_PASSWORD=robots_test
POSTGRES_TEST_DB=robots_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql://robots_test:robots_test@127.0.0.1:5433/robots_test?schema=public

# Backend (apps/api)
API_PORT=3001

# Frontend (apps/web): куда Next проксирует запросы /api/*
API_INTERNAL_URL=http://localhost:3001
