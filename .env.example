# Скопируйте в .env (pnpm i делает это автоматически, если .env ещё нет).
# Секреты в репозиторий не коммитим.

NODE_ENV=development

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=robots
POSTGRES_PASSWORD=robots
POSTGRES_DB=robots
POSTGRES_PORT=5432
DATABASE_URL=postgresql://robots:robots@localhost:5432/robots?schema=public

# Backend (apps/api)
API_PORT=3001

# Frontend (apps/web): куда Next проксирует запросы /api/*
API_INTERNAL_URL=http://localhost:3001
